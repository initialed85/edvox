# llama-server chat API on this host
CHAT_BASE_URL=http://127.0.0.1:8088/v1
CHAT_MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_XL
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=256
CHAT_TIMEOUT=300
CHAT_SYSTEM_PROMPT=
CHAT_SYSTEM_PROMPT_FILE=
CHAT_HISTORY_TURNS=8

# STT (server keeps Whisper loaded; set STT_BACKEND=cli for one-shot whisper-cli)
STT_BACKEND=server
STT_URL=http://127.0.0.1:8178
STT_TIMEOUT=120
STT_MODEL=models/ggml-base.en.bin
STT_LANG=en
AUDIO_DEVICE=:1
RECORD_SECONDS=5

# TTS_BACKEND=qwen, chatterbox, nano, or turbo
TTS_BACKEND=qwen
TTS_MODEL=models/Qwen3-TTS-12Hz-1.7B-Base-Q4_K_M.gguf
TTS_MMPROJ=models/mmproj-Qwen3-TTS-12Hz-1.7B-Base-Q8_0.gguf
TTS_LANG=en
TTS_FRAMES=512
# TTS_SPEAKER_FILE=/path/to/reference.wav

# Resident Chatterbox service
TTS_URL=http://127.0.0.1:8190
TTS_TIMEOUT=300

# Chatterbox
CHATTERBOX_MODEL=nano
CHATTERBOX_MODEL_DIR=models/chatterbox-nano
CHATTERBOX_DEVICE=mps

# llama-server launcher tuning
CHAT_HOST=127.0.0.1
CHAT_PORT=8088
CHAT_HF_REPO=unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_XL
CHAT_CTX_SIZE=32768
CHAT_PARALLEL=1
CHAT_SPEC_TYPE=draft-mtp
CHAT_SPEC_DRAFT_N_MAX=2
CHAT_REASONING=off
CHAT_CACHE_TYPE_K=q8_0
CHAT_CACHE_TYPE_V=q8_0
